# ============================================================================
# CREDENCIAIS DA API CAKTO (Configure na Vercel em Settings > Environment Variables)
# Painel Cakto: https://app.cakto.com.br/dashboard/cakto-api
# ============================================================================

# Obrigatórias (Client ID e Client Secret da sua chave Cakto API com escopo "payments")
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# Opcionais (IDs das ofertas na Cakto; já possuem fallback automático para as ofertas R$ 18 e R$ 10)
CAKTO_OFFER_ID_18=3zg3ztg
CAKTO_OFFER_ID_10=jrt32bg
